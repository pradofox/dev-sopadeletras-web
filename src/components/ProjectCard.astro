---
interface Props {
  href: string;
  title: string;
  client: string;
  categories: string[];
  duration: string;
  cover: string;
  index?: number;
}
const { href, title, client, categories, duration, cover, index = 0 } = Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<a href={href} class="card" data-card>
  <div class="card__media">
    <img src={cover} alt={`Portada del proyecto ${title}`} loading="lazy" decoding="async" />
    <span class="card__num" aria-hidden="true">{num}</span>
  </div>

  <div class="card__meta">
    <div class="card__head">
      <span class="eyebrow">trabajo</span>
      <h3 class="card__title">{title}</h3>
    </div>
    <dl class="card__info">
      <div><dt>cliente</dt><dd>{client}</dd></div>
      <div><dt>categoría</dt><dd>{categories.join(', ').toLowerCase()}</dd></div>
      <div><dt>duración</dt><dd>{duration}</dd></div>
    </dl>
    <span class="card__cta" aria-hidden="true">
      ver proyecto
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M1 13L13 1M13 1H4M13 1V10" />
      </svg>
    </span>
  </div>
</a>

<style>
  .card {
    display: grid;
    grid-template-rows: auto auto;
    gap: var(--sp-3);
    color: var(--fg);
    transition: opacity var(--dur) var(--ease-out);
  }
  .card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--subtle);
  }
  .card__media img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 800ms var(--ease-out);
  }
  .card:hover .card__media img { transform: scale(1.04); }

  .card__num {
    position: absolute;
    top: var(--sp-3);
    left: var(--sp-3);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    color: rgba(255,255,255,0.85);
    background: rgba(29,29,31,0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 4px 8px;
    letter-spacing: 0.05em;
  }

  .card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-top: var(--sp-2);
  }
  .card__head { display: flex; flex-direction: column; gap: var(--sp-1); }
  .card__title {
    font-size: var(--fs-xl);
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .card__info {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-1);
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .card__info > div { display: grid; grid-template-columns: 90px 1fr; gap: var(--sp-2); }
  .card__info dt { font-variant-numeric: tabular-nums; text-transform: uppercase; letter-spacing: 0.08em; }
  .card__info dd { margin: 0; color: var(--fg); }

  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--fg);
    margin-top: var(--sp-2);
  }
  .card__cta svg { transition: transform var(--dur) var(--ease-out); }
  .card:hover .card__cta svg { transform: translate(2px, -2px); }
</style>
