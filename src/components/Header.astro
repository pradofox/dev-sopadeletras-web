---
import { nav, site } from '../data/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
---

<header class="hdr" data-header>
  <div class="container hdr__inner">
    <a href="/" class="hdr__brand" aria-label={`${site.name} — inicio`}>
      <Logo class="hdr__logo" />
    </a>

    <nav class="hdr__nav" aria-label="Navegación principal">
      {nav.filter(n => n.href !== '/').map(item => {
        const base = item.href.split('#')[0];
        const isActive = path === item.href || (base !== '/' && path.startsWith(base));
        return (
          <a href={item.href} class:list={['hdr__link', { 'is-active': isActive }]}>
            {item.label}
          </a>
        );
      })}
    </nav>

    <button class="hdr__menu" type="button" aria-label="Abrir menú" aria-expanded="false" id="menu-toggle">
      <span></span><span></span>
    </button>
  </div>

  <div class="hdr__sheet" id="menu-sheet" hidden>
    <nav aria-label="Navegación móvil" class="hdr__sheet-nav">
      {nav.map(item => (
        <a href={item.href} class="hdr__sheet-link">{item.label}</a>
      ))}
    </nav>
    <div class="hdr__sheet-foot">
      <a href={`mailto:${site.email}`} class="link">{site.email}</a>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    pointer-events: none;
    /* mix-blend-mode hace que el contenido (logo + nav) se invierta sobre el fondo:
       sobre claro se ve negro, sobre oscuro se ve blanco. */
    mix-blend-mode: difference;
    color: #fff;
  }
  .hdr__inner {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--sp-4);
    gap: var(--sp-4);
  }

  .hdr__brand { display: inline-flex; align-items: center; }
  :global(.hdr__logo) {
    display: block;
    height: 22px;
    width: auto;
    color: #fff; /* el blend-mode lo invierte */
  }
  @media (min-width: 768px) {
    :global(.hdr__logo) { height: 26px; }
  }

  .hdr__nav {
    display: none;
    gap: var(--sp-6);
    align-items: center;
  }
  .hdr__link {
    font-size: var(--fs-sm);
    color: #fff;
    opacity: 0.7;
    transition: opacity var(--dur-fast) var(--ease-out);
    padding: 4px 0;
    position: relative;
  }
  .hdr__link:hover { opacity: 1; }
  .hdr__link.is-active { opacity: 1; }
  .hdr__link.is-active::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -2px;
    height: 1px; background: #fff;
  }

  .hdr__menu {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px; height: 32px;
    padding: 8px 4px;
    color: #fff;
  }
  .hdr__menu span {
    display: block; height: 1.5px; background: currentColor;
    transition: transform var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out);
  }
  .hdr__menu[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(3.5px) rotate(45deg);
  }
  .hdr__menu[aria-expanded="true"] span:nth-child(2) {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  .hdr__sheet {
    position: fixed;
    inset: 64px 0 0 0;
    background: var(--bg);
    color: var(--fg);
    padding: var(--sp-8) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    z-index: 40;
    mix-blend-mode: normal;
  }
  .hdr__sheet[hidden] { display: none; }
  .hdr__sheet-nav { display: flex; flex-direction: column; gap: var(--sp-3); }
  .hdr__sheet-link {
    font-size: var(--fs-2xl);
    letter-spacing: -0.03em;
  }
  .hdr__sheet-foot { padding-bottom: var(--sp-8); }

  @media (min-width: 768px) {
    .hdr__nav { display: inline-flex; }
    .hdr__menu { display: none; }
    .hdr__sheet { display: none !important; }
  }

  /* Spacer para que el contenido no quede debajo del header fixed */
  :global(main) { padding-top: 64px; }
</style>

<script>
  const init = () => {
    const btn = document.getElementById('menu-toggle');
    const sheet = document.getElementById('menu-sheet');
    if (!btn || !sheet) return;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      if (open) sheet.setAttribute('hidden', '');
      else sheet.removeAttribute('hidden');
      document.body.style.overflow = open ? '' : 'hidden';
    });
    sheet.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      btn.setAttribute('aria-expanded', 'false');
      sheet.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }));
  };
  document.addEventListener('astro:page-load', init);
</script>
