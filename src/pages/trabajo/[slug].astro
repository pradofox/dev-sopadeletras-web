---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import { site } from '../../data/site';

export const prerender = true;

export async function getStaticPaths() {
  const items = (await getCollection('portfolio')).filter(p => !p.data.draft);
  return items.map(p => ({ params: { slug: p.id }, props: { p, all: items } }));
}

const { p, all } = Astro.props as { p: any; all: any[] };
const { Content } = await render(p);

const sorted = all.sort((a, b) => a.data.order - b.data.order);
const idx = sorted.findIndex(x => x.id === p.id);
const next = sorted[(idx + 1) % sorted.length];
const related = sorted.filter(x => x.id !== p.id).slice(0, 3);

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.data.title,
  description: p.data.summary,
  creator: { '@type': 'Organization', name: 'sopadeletras®', url: site.url },
  about: p.data.client,
  keywords: p.data.categories.join(', '),
  image: p.data.cover,
  url: new URL(`/trabajo/${p.id}`, site.url).toString(),
};
---

<Base
  title={p.data.title}
  description={p.data.summary}
  ogImage={p.data.cover}
  schema={projectSchema}
>
  <article>
    <!-- HERO -->
    <section class="phead">
      <div class="container">
        <a href="/trabajo" class="phead__back link">← trabajo</a>
        <h1 class="phead__title">{p.data.title}</h1>
        <p class="phead__summary">{p.data.summary}</p>

        <dl class="meta">
          <div>
            <dt>cliente</dt>
            <dd>{p.data.client}</dd>
          </div>
          <div>
            <dt>categoría</dt>
            <dd>
              <ul>
                {p.data.categories.map((c: string) => <li>{c}</li>)}
              </ul>
            </dd>
          </div>
          <div>
            <dt>duración</dt>
            <dd>{p.data.duration}</dd>
          </div>
          {p.data.collaborators.length > 0 && (
            <div>
              <dt>colaboradores</dt>
              <dd>{p.data.collaborators.join(', ')}</dd>
            </div>
          )}
        </dl>
      </div>
    </section>

    <!-- COVER -->
    <section class="cover">
      <div class="container">
        <div class="cover__media">
          <img src={p.data.cover} alt={`Imagen principal de ${p.data.title}`} />
        </div>
      </div>
    </section>

    <!-- QUOTE + BODY -->
    {p.data.quote && (
      <section class="quote">
        <div class="container">
          <blockquote>"{p.data.quote}"</blockquote>
        </div>
      </section>
    )}

    <section class="body">
      <div class="container body__inner">
        <div class="body__side">
          <span class="eyebrow">nuestro acercamiento</span>
        </div>
        <div class="body__prose prose">
          <Content />
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    {p.data.gallery.length > 1 && (
      <section class="gal">
        <div class="container">
          <div class="gal__grid">
            {p.data.gallery.slice(1).map((g: any) => (
              <figure class="gal__item">
                <img src={g.src} alt={g.alt ?? `Imagen de ${p.data.title}`} loading="lazy" />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- NEXT / RELATED -->
    <section class="next">
      <div class="container">
        <div class="next__bar">
          <span class="eyebrow">siguiente proyecto</span>
          <a href={`/trabajo/${next.id}`} class="next__link link">{next.data.title} →</a>
        </div>

        <header class="related-head">
          <span class="eyebrow">otros proyectos</span>
          <a href="/trabajo" class="link">ver todos →</a>
        </header>
        <div class="grid">
          {related.map((r: any, i: number) => (
            <ProjectCard
              href={`/trabajo/${r.id}`}
              title={r.data.title}
              client={r.data.client}
              categories={r.data.categories}
              duration={r.data.duration}
              cover={r.data.cover}
              index={i}
            />
          ))}
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .phead { padding-top: var(--sp-8); padding-bottom: var(--sp-8); }
  .phead__back { font-size: var(--fs-sm); color: var(--muted); }
  .phead__title {
    font-size: var(--fs-display);
    line-height: 0.95;
    letter-spacing: -0.045em;
    margin-block: var(--sp-5) var(--sp-3);
    font-weight: 400;
  }
  .phead__summary {
    font-size: var(--fs-xl);
    color: var(--muted);
    max-width: 60ch;
    line-height: 1.4;
    margin-bottom: var(--sp-8);
  }

  .meta {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
    border-top: 1px solid var(--border);
    padding-top: var(--sp-5);
    margin: 0;
  }
  @media (min-width: 768px) { .meta { grid-template-columns: repeat(4, 1fr); gap: var(--sp-6); } }
  .meta > div { display: flex; flex-direction: column; gap: var(--sp-2); }
  .meta dt {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .meta dd { margin: 0; font-size: var(--fs-base); }
  .meta ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }

  .cover { padding-block: var(--sp-6); }
  .cover__media { aspect-ratio: 16/10; overflow: hidden; background: var(--subtle); }
  .cover__media img { width: 100%; height: 100%; object-fit: cover; }

  .quote { padding-block: var(--sp-10); }
  .quote blockquote {
    font-size: var(--fs-3xl);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-style: italic;
    max-width: 24ch;
    margin: 0;
  }

  .body__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }
  @media (min-width: 768px) {
    .body__inner { grid-template-columns: 240px 1fr; gap: var(--sp-10); }
  }
  .prose {
    max-width: 62ch;
    font-size: var(--fs-lg);
    line-height: 1.55;
    color: var(--fg);
  }
  .prose :global(p) { margin-bottom: var(--sp-4); }
  .prose :global(blockquote) {
    border-left: 2px solid var(--accent);
    padding-left: var(--sp-4);
    margin: var(--sp-6) 0;
    font-style: italic;
    font-size: var(--fs-xl);
    line-height: 1.35;
  }
  .prose :global(strong) { font-weight: 500; }
  .prose :global(em) { font-style: italic; }

  .gal { padding-block: var(--sp-10); }
  .gal__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }
  @media (min-width: 768px) { .gal__grid { grid-template-columns: 1fr 1fr; gap: var(--sp-5); } }
  .gal__item { margin: 0; }
  .gal__item img { width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; background: var(--subtle); }
  .gal__item figcaption { font-size: var(--fs-xs); color: var(--muted); padding-top: var(--sp-2); }

  .next { padding-top: var(--sp-10); }
  .next__bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding-block: var(--sp-5);
    margin-bottom: var(--sp-12);
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .next__link { font-size: var(--fs-2xl); letter-spacing: -0.03em; }

  .related-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--sp-6);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8) var(--sp-6);
  }
  @media (min-width: 720px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .grid { grid-template-columns: repeat(3, 1fr); } }
</style>
